/*
    {{scheme-name}} - color scheme for ansi2html.html
    https://github.com/clach04/terminal_style_toolkit/

    "scheme-name": "{{scheme-name}}",
    "scheme-author": "{{scheme-author}}",
    "scheme-slug": "{{scheme-slug}}",

    scheme-comment:  {{scheme-comment}}
    scheme-comment1: {{scheme-comment1}}
    scheme-comment2: {{scheme-comment2}}
    scheme-comment3: {{scheme-comment3}}
    scheme-comment4: {{scheme-comment4}}
    scheme-comment5: {{scheme-comment5}}
    scheme-comment6: {{scheme-comment6}}
    scheme-comment7: {{scheme-comment7}}
    scheme-comment8: {{scheme-comment8}}
    scheme-comment9: {{scheme-comment9}}

    Generated with:
        py -3 putty/any2theme.py {{scheme-slug}}.tstk --output_extension .css -t ansi2html_css.mustache

    Paste the CSS below into the "Custom CSS (Color Scheme)" field of
    ansi2html.html - it targets the class names emitted by ansi_up v6
    (https://github.com/drudru/ansi_up) when "Use CSS Classes" is enabled.

    NOTE tstk has a single color per ANSI slot; the same value is emitted
    for both the -fg and -bg CSS classes (mintty-style limitation).
*/

/* Colour0 - Default Foreground */
/*  Colour0-comment: {{Colour0-comment}} */
/*     Colour0-note: {{Colour0-note}} */
#terminal-output {
    background-color: #{{Colour2-hex}};
    color: #{{Colour0-hex}};
}

/* ANSI Black - 30m / 40m */
/*  Colour6-comment: {{Colour6-comment}} */
/*     Colour6-note: {{Colour6-note}} */
#terminal-output .ansi-black-fg { color: #{{Colour6-hex}}; }
#terminal-output .ansi-black-bg { background-color: #{{Colour6-hex}}; }

/* ANSI Black Bright - 1;30m */
